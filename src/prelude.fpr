# ---- prelude: the small list and integer helpers -------------------------------------
# Kept out of the game: index math, list surgery and the LCG the shuffle draws from.

L = use "std/list".
M = use "std/math".

nth : List a -> Int -> a -> a .
nth l i d = L.getWithDefault d i l.

setAt : List a -> Int -> a -> List a .
setAt l i v = L.setAt i v l.

delAt : List a -> Int -> List a .
delAt l i = L.removeAt i l.

rev : List a -> List a -> List a .
rev l acc = L.revOnto l acc.

bi : Bool -> Int .
bi True = 1.
bi False = 0.

rnd : Int -> Int .
rnd s = (s * 1103515245 + 12345) % 2147483648.

split : (l : List a | measure l) -> Int -> List a -> (List a, List a) .
split l n acc =
  if n == 0 then (L.reverse acc, l)
  else case l of
    Nil -> (L.reverse acc, Nil)
  | x :: r -> split r (n - 1) (x :: acc).

clampTo : Int -> Int -> Int .
clampTo v hi = M.clamp 0 hi v.
