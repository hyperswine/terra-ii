# ---- the terminal: the model as a data console -------------------------------------------

unsafe module.

Pr = use "prelude".
Cd = use "cards".
Bd = use "board".
Md = use "model".
Ru = use "rules".
Core = use "mods/coreutil".
Sfx = use "mods/sfx".

# Typed from the evdev codes (so a replayed key file types too; the
# live window's char events are ignored, one source of truth): letters,
# digits, space . - = , /.  Enter runs the line, backspace edits, esc
# closes.  Every line and its answer also go to the transcript.

termKey m 1 = (Md.cue (Md.goBack m) Sfx.cancel, Nil).
termKey m 59 = ({ m | snap = m.snap + 1 }, Nil).
termKey m 28 = (runTerm m, Nil).
termKey m 14 = ({ m | tin = dropLast m.tin }, Nil).
termKey m k =
  ch = keyChar k;
  case strlen ch == 0 or strlen m.tin >= 60 of
    True -> (m, Nil)
  | False -> ({ m | tin = m.tin + ch }, Nil).
dropLast s | strlen s == 0 = s.
dropLast s = substr s 0 (strlen s - 1).
keyChar k | k >= 2 and k <= 10 = chr (k + 47).
keyChar 11 = "0".
keyChar 57 = " ".
keyChar 12 = "-".
keyChar 52 = ".".
keyChar 13 = "=".
keyChar 51 = ",".
keyChar 53 = "/".
keyChar k = letterOf k "qwertyuiop" 16 (letterOf k "asdfghjkl" 30 (letterOf k "zxcvbnm" 44 "")).
letterOf k row base dflt | k >= base and k < base + strlen row = chr (charAt row (k - base)).
letterOf k row base dflt = dflt.

runTerm m =
  line = m.tin;
  (m2, out) = termRun m (twords line);
  shown = ("> " + line) :: out;
  { m2 | tin = "", tout = List.take (Pr.rev out Nil + (("> " + line) :: m.tout)) 14,
         log = Pr.rev (shown |> List.map (fn s -> "term: " + s)) Nil + m2.log }.
twords s = twGo s 0 (strlen s) Nil.
twGo s i n acc | i >= n = Pr.rev acc Nil.
twGo s i n acc =
  (w, j) = Core.wordAt s i n;
  case strlen w == 0 of True -> twGo s j n acc | False -> twGo s j n (w :: acc).
eq a b = Core.strEq a b.
tnum s = Core.parseDigits s.

# commands -> (model, output lines)
termRun m Nil = (m, termHelp).
termRun m (w :: r) | eq w "help" = (m, termHelp).
termRun m (w :: r) | eq w "ls" =
  (m, ["me.hq me.stock en.hq en.stock env tno turn seed music auto hs ss cur zone",
       "me.hand en.hand me.deck en.deck prof.played prof.won prof.lost",
       "me.fwd.N en.rear.N (a unit; .hp .atk .ready .mode .down .chg .vet to set)"]).
termRun m (w :: p :: r) | eq w "get" = (m, [("{p} = " + getP m (parts p))]).
termRun m (w :: p :: v :: r) | eq w "set" = setP m (parts p) (tnum v).
termRun m (w :: side :: r) | eq w "hand" = (m, [handText m (sideNo side)]).
termRun m (w :: r) | eq w "board" = (m, [rowText m 0 1, rowText m 0 2, rowText m 1 1, rowText m 1 2]).
termRun m (w :: side :: id :: r) | eq w "deal" = dealCmd m (sideNo side) (tnum id).
termRun m (w :: side :: z :: c :: id :: r) | eq w "place" = placeCmd m (sideNo side) (tnum z) (tnum c) (tnum id).
termRun m (w :: side :: z :: c :: r) | eq w "clear" = clearCmd m (sideNo side) (tnum z) (tnum c).
termRun m (w :: side :: n :: r) | eq w "hit" = (Ru.damageHq m (sideNo side) (tnum n), ["HQ of {side} hit for {tnum n}"]).
termRun m (w :: r) = (m, ["unknown: {w} (help)"]).
termHelp =
  ["get PATH        set PATH N       ls (the paths)",
   "hand me|en      board            deal me|en CARD",
   "place me|en ZONE COL CARD        clear me|en ZONE COL",
   "hit me|en N (the rules' HQ damage: victory and defeat apply)"].
sideNo s | eq s "en" = 1.
sideNo s = 0.
parts s = ptGo s 0 0 (strlen s) Nil.
ptGo s st i n acc | i >= n = Pr.rev (substr s st (i - st) :: acc) Nil.
ptGo s st i n acc | charAt s i == 46 = ptGo s (i + 1) (i + 1) n (substr s st (i - st) :: acc).
ptGo s st i n acc = ptGo s st (i + 1) n acc.

# paths, read
getP m (a :: Nil) | eq a "env" = "{m.env}".
getP m (a :: Nil) | eq a "tno" = "{m.tno}".
getP m (a :: Nil) | eq a "turn" = "{m.turn}".
getP m (a :: Nil) | eq a "seed" = "{m.seed}".
getP m (a :: Nil) | eq a "music" = "{m.music}".
getP m (a :: Nil) | eq a "auto" = "{m.auto}".
getP m (a :: Nil) | eq a "hs" = "{m.hs}".
getP m (a :: Nil) | eq a "ss" = "{m.ss}".
getP m (a :: Nil) | eq a "cur" = "{m.cur}".
getP m (a :: Nil) | eq a "zone" = "{m.zone}".
getP m (a :: Nil) | eq a "screen" = "{m.back}".
getP m (a :: b :: Nil) | eq a "prof" and eq b "played" = "{m.prof.played}".
getP m (a :: b :: Nil) | eq a "prof" and eq b "won" = "{m.prof.won}".
getP m (a :: b :: Nil) | eq a "prof" and eq b "lost" = "{m.prof.lost}".
getP m (a :: b :: Nil) | (eq a "me" or eq a "en") and eq b "hq" = p = Bd.sideOf m (sideNo a); "{p.hq}".
getP m (a :: b :: Nil) | (eq a "me" or eq a "en") and eq b "stock" = p = Bd.sideOf m (sideNo a); "{p.stock}".
getP m (a :: b :: Nil) | (eq a "me" or eq a "en") and eq b "hand" = handText m (sideNo a).
getP m (a :: b :: Nil) | (eq a "me" or eq a "en") and eq b "deck" = p = Bd.sideOf m (sideNo a); "{List.len p.deck} cards".
getP m (a :: b :: c :: Nil) | (eq a "me" or eq a "en") and (eq b "fwd" or eq b "rear") = unitText (Bd.slotOf (Bd.sideOf m (sideNo a)) (zoneNo b) (tnum c - 1)).
getP m (a :: b :: c :: f :: Nil) | (eq a "me" or eq a "en") and (eq b "fwd" or eq b "rear") = "{unitField (Bd.slotOf (Bd.sideOf m (sideNo a)) (zoneNo b) (tnum c - 1)) f}".
getP m p = "? (ls lists the paths)".
zoneNo b | eq b "fwd" = 1.
zoneNo b = 2.

# paths, written (Ints)
setP m (a :: Nil) v | eq a "env" = ({ m | env = Int.max 0 (Int.min 10 v) }, "env = {Int.max 0 (Int.min 10 v)}" :: Nil).
setP m (a :: Nil) v | eq a "tno" = ({ m | tno = v }, "tno = {v}" :: Nil).
setP m (a :: Nil) v | eq a "seed" = ({ m | seed = v }, "seed = {v}" :: Nil).
setP m (a :: Nil) v | eq a "music" = ({ m | music = v }, "music = {v}" :: Nil).
setP m (a :: Nil) v | eq a "auto" = ({ m | auto = v }, "auto = {v}" :: Nil).
setP m (a :: Nil) v | eq a "hs" = ({ m | hs = v }, "hs = {v}" :: Nil).
setP m (a :: Nil) v | eq a "ss" = ({ m | ss = v }, "ss = {v}" :: Nil).
setP m (a :: b :: Nil) v | (eq a "me" or eq a "en") and eq b "hq" =
  p = Bd.sideOf m (sideNo a);
  (Bd.setSide m (sideNo a) { p | hq = v }, ["{a}.hq = {v}"]).
setP m (a :: b :: Nil) v | (eq a "me" or eq a "en") and eq b "stock" =
  p = Bd.sideOf m (sideNo a);
  (Bd.setSide m (sideNo a) { p | stock = v }, ["{a}.stock = {v}"]).
setP m (a :: b :: c :: f :: Nil) v | (eq a "me" or eq a "en") and (eq b "fwd" or eq b "rear") =
  s = sideNo a;
  z = zoneNo b;
  col = tnum c - 1;
  p = Bd.sideOf m s;
  u = Bd.slotOf p z col;
  case Bd.alive u of
    False -> (m, ["no unit at {a}.{b}.{c}"])
  | True -> (Bd.setSide m s (Bd.setSlot p z col (setUnitField u f v)), ["{a}.{b}.{c}.{f} = {v}"]).
setP m p v = (m, ["cannot set that (ls lists the paths)"]).
unitField u f | eq f "hp" = u.hp.
unitField u f | eq f "atk" = u.atk.
unitField u f | eq f "ready" = u.ready.
unitField u f | eq f "mode" = u.mode.
unitField u f | eq f "down" = u.down.
unitField u f | eq f "chg" = u.chg.
unitField u f | eq f "vet" = u.vet.
unitField u f = 0 - 1.
setUnitField u f v | eq f "hp" = { u | hp = v }.
setUnitField u f v | eq f "atk" = { u | atk = v }.
setUnitField u f v | eq f "ready" = { u | ready = v }.
setUnitField u f v | eq f "mode" = { u | mode = v }.
setUnitField u f v | eq f "down" = { u | down = v }.
setUnitField u f v | eq f "chg" = { u | chg = v }.
setUnitField u f v | eq f "vet" = { u | vet = v }.
setUnitField u f v = u.
unitText u | Bd.alive u = "{Cd.cName (Bd.uCard u)} {u.atk}/{u.hp} ready {u.ready} mode {u.mode} down {u.down} chg {u.chg} vet {u.vet}".
unitText u = "empty".
handText m s =
  p = Bd.sideOf m s;
  Core.joinWith " " (p.hand |> List.map (fn k -> "{k}:{Cd.cName (Cd.cardOf k)}")).
rowText m s z =
  p = Bd.sideOf m s;
  who = case s == 0 of True -> "me" | False -> "en";
  who + "." + (case z == 1 of True -> "fwd" | False -> "rear") + ": " +
  Core.joinWith "  " (Bd.rowOf p z |> List.map (fn u -> case Bd.alive u of True -> "{Cd.cName (Bd.uCard u)} {u.atk}/{u.hp}" | False -> "-")).
dealCmd m s id | strlen (Cd.cName (Cd.cardOf id)) == 1 = (m, ["no card {id}"]).
dealCmd m s id =
  p = Bd.sideOf m s;
  (Bd.setSide m s { p | hand = p.hand + [id] }, ["dealt {Cd.cName (Cd.cardOf id)} to {Md.sideName s}"]).
placeCmd m s z c id | z < 1 or z > 2 or c < 1 or c > 5 = (m, ["place me|en ZONE(1 fwd, 2 rear) COL(1-5) CARD"]).
placeCmd m s z c id | strlen (Cd.cName (Cd.cardOf id)) == 1 = (m, ["no card {id}"]).
placeCmd m s z c id =
  p = Bd.sideOf m s;
  u = Bd.mkU (Cd.cardOf id) 0;
  (Bd.setSide m s (Bd.setSlot p z (c - 1) { u | born = 1000, ready = 1 }), ["placed {Cd.cName (Cd.cardOf id)} at {Md.sideName s} {Md.zoneName z} {c}"]).
clearCmd m s z c | z < 1 or z > 2 or c < 1 or c > 5 = (m, ["clear me|en ZONE COL"]).
clearCmd m s z c =
  p = Bd.sideOf m s;
  (Bd.setSide m s (Bd.setSlot p z (c - 1) Bd.noU), ["cleared {Md.sideName s} {Md.zoneName z} {c}"]).
