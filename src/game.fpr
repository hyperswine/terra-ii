# ---- Terra II as a std/game app, minus its view ----------------------------------------
# init, update and subs: pure functions over the model. Everything the game
# does to the world it ASKS for, as the value update returns: the transcript
# and the sound cues a tick produced, the music's volume, a frame capture,
# quit, and the disk (the profile and the saved game are read by tasks whose
# answers are messages; saves are acknowledged one at a time, save.fpr).
# Nothing here opens or plays anything, so a test plays a match with Game.play
# and reads back the model and the requests (tests/game.fpr).

unsafe module.

Game = use "std/game".
O = use "std/option".
Pr = use "prelude".
Md = use "model".
Ac = use "actions".
Ui = use "ui".
Inp = use "input".
Sv = use "save".

# Tick: 40 ms of game time.  KeyIn / Wheel: the player.  The rest are answers
# from the disk: the profile and the saved game at start, and each save's
# acknowledgement (Wrote) or, after an unconfirmed one, the profile read back
# (Checked), by the save's identity.
Msg = Type (Tick | KeyIn k | Wheel dy | GotProfile r | GotGame r | Wrote id r | Checked id r).

tickMs = 40.
musicFile = Inp.musicFile.

init flags = (Md.initModel, Sv.loadTasks GotProfile GotGame).

update msg m =
  (m1, cs) = step msg m;
  (m2, tunes) = tuned m1;
  (m3, saves) = Sv.flush Wrote Checked m2;
  (m3, Game.batch (tunes + cs + captured m m3 + saves)).

step Tick m = tick (Sv.rested m).
step (KeyIn k) m = Inp.keyIn m k.
step (Wheel dy) m = (Ui.wheel m dy, Nil).
step (GotProfile r) m = Sv.gotProfile m r.
step (GotGame r) m = Sv.gotGame m r.
step (Wrote id r) m = Sv.wrote Wrote Checked m id r.
step (Checked id r) m = Sv.checked Wrote Checked m id r.

# ---- the tick ----------------------------------------------------------------------------
# The rules and the input handlers queue their words (m.log) and their cues
# (m.sfx) on the model; the tick that ran them asks for them, once.
tick m | m.qt > 0 and m.qt <= tickMs = (m, [Game.quit]).
tick m | m.qt > 0 = ({ m | qt = m.qt - tickMs }, Nil).
tick m | Md.frozen m =
  (m2, cs) = takeKey { m | ms = m.ms + tickMs, log = Nil, sfx = Nil };
  (m2, spoken m2 + cs).
tick m =
  m1 = Ac.ageAll { m | ms = m.ms + tickMs, log = Nil, sfx = Nil } tickMs;
  Md.An kind s fz fc tz tc t done = m1.anim;
  (m2, cs) = case kind != 0 of
    True -> (Ac.advance m1 tickMs, Nil)
  | False -> idle m1;
  (m2, spoken m2 + cs).
idle m = case m.queue of
    a :: r -> (Ac.startAct { m | queue = r } a, Nil)
  | Nil -> takeKey m.
takeKey m = case m.keys of
    Nil -> (m, Nil)
  | k :: r -> Inp.key { m | keys = r } k.

# the transcript, then the cues, oldest first. A cue's variation is the clock
# plus 37 for every tone before it in this tick: four rifle cracks in a row are
# four cracks, not one four times.
spoken m = lines (Pr.rev m.log Nil) + cues m.ms 0 (Pr.rev m.sfx Nil).
lines Nil = Nil.
lines (s :: r) = Game.log "[terra2] {s}" :: lines r.
cues seed n Nil = Nil.
cues seed n (riff :: r) = Game.sound riff (seed + n * 37) :: cues seed (n + List.len riff) r.

# the music's volume requests, oldest first
tuned m = case m.mus of
    Nil -> (m, Nil)
  | vs -> ({ m | mus = Nil }, volumes (Pr.rev vs Nil)).
volumes Nil = Nil.
volumes (v :: r) = Game.music musicFile v :: volumes r.

captured m m2 | m2.snap == m.snap = Nil.
captured m m2 = [Game.capture].

subs m = [Game.tick tickMs Tick, Game.keys keyMsg, Game.wheel wheelMsg].
# the live window also sends characters as negative codes: not keys
keyMsg k = if k < 0 then O.None else O.Some (KeyIn k).
wheelMsg dy dx = O.Some (Wheel dy).
