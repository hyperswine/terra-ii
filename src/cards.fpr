# fallback for unknown card ids
cardOf k = Card k "?" 99 0 1 0 0 0 0.

cName (Card i n co a d g dr k s) = n.
cCost (Card i n co a d g dr k s) = co.
cAtk (Card i n co a d g dr k s) = a.
cDef (Card i n co a d g dr k s) = d.
cGen (Card i n co a d g dr k s) = g.
cDrain (Card i n co a d g dr k s) = dr.
cKind (Card i n co a d g dr k s) = k.
cSoft (Card i n co a d g dr k s) = s.
cId (Card i n co a d g dr k s) = i.

# the decks (tactics cut: 34 cards each), as copies of ids
reps : Int -> (n : Int | measure n) -> List Int .
reps k n | n <= 0 = Nil.
reps k n = k :: reps k (n - 1).

# the Republic VI deck: a list of card ids with repetitions according to the deck composition
deckRep = reps 0 3 + reps 1 2 + reps 2 2 + reps 3 3 + reps 4 3
        + reps 5 3 + reps 6 3 + reps 7 3 + reps 8 2 + reps 9 2
        + reps 10 2 + reps 11 2 + reps 12 2 + reps 13 1 + reps 14 1 + reps 15 1.

# the Southern Empire deck: a list of card ids with repetitions according to the deck composition
deckSou = reps 20 3 + reps 21 2 + reps 22 2 + reps 23 2 + reps 24 3
        + reps 25 3 + reps 26 3 + reps 27 3 + reps 28 2 + reps 29 2
        + reps 30 2 + reps 31 2 + reps 32 2 + reps 33 1 + reps 34 1 + reps 35 1.

# Draw a card at random from the cards left and deal it onto the pile, until
# none are left.  The cards left are a linear Vector (written in place): the
# drawn card's place is closed up so the rest keep their order, which is what
# keeps every seed's deck the same as before.
shuffle seed l = shuf seed Nil (Vec.fromList l) (List.len l).
shuf : Int -> List Int -> Vector Int -> (n : Int | measure n) -> List Int .
shuf seed acc v n | n <= 0 = _ = Vec.free v; acc.
shuf seed acc v n =
  s2 = Pr.rnd seed;
  k = s2 % n;
  (x, v1) = Vec.get k v;
  shuf s2 (x :: acc) (closeUp v1 k (n - 1)) (n - 1).
# cards i+1 .. last move down one place
closeUp : Vector Int -> (i : Int | measure (last - i)) -> (last : Int) -> Vector Int .
closeUp v i last | i >= last = v.
closeUp v i last =
  (y, v1) = Vec.get (i + 1) v;
  closeUp (Vec.set i y v1) (i + 1) last.

facIds 0 = range 0 15.
facIds f = range 20 35.
range a b | a > b = Nil.
range a b = a :: range (a + 1) b.
