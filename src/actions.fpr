# ---- the queue: an action's animation, and the tick that plays it -----------------------

unsafe module.

Pr = use "prelude".
Bd = use "board".
Cd = use "cards".
Md = use "model".
Ru = use "rules".
AI = use "ai".
Ui = use "ui".
Sfx = use "mods/sfx".

# startAct validates an action and picks its animation; the midpoint applies
# the rule, and the end clears it.

startAct m a = case a of
    Md.ABeat -> pause m 260
  | Md.AStart s ->
    m2 = Ru.startTurn m s;
    m3 = case s == 1 of True -> { m2 | queue = AI.aiPlan m2 + [Md.AEnd 1] } | False -> m2;
    pause { m3 | dirty = Pr.bi (s == 0) } 900
  | Md.AEnd s -> pause (Ru.endTurn m s) 500
  | Md.ACall s i z c -> flyCard (Ru.callCard m s i z c) m s i z c
  | Md.AOver s c -> pause (overwatch m s c) 250
  | Md.ACharge s c -> pause (charge m s c) 250
  | Md.ARetreat s c -> slide m s 1 c 2 c
  | Md.AAdvance s c -> slide m s 2 c 1 c
  | Md.AAttack s z c tz tc -> attack m s c tz tc
  | Md.AFire s c tz tc -> fire m s c tz tc.
pause m ms = { m | anim = Md.An 4 0 0 0 0 0 (0 - ms) 1 }.
# the summon: a card slab flies from the hand's edge (the enemy's from
# beyond its HQ) to the slot over 380 ms, easing in and out, shrinking;
# the unit pops up as it lands (its born runs up from -380).  A refused
# call has left the model unchanged: no flight, a short beat.
flyCard m2 m s i z c | m2.me.stock == m.me.stock and m2.en.stock == m.en.stock = pause m2 250.
flyCard m2 m s i z c = { m2 | anim = Md.An 5 s i 0 z c 0 1 }.

overwatch m s c =
  p = Bd.sideOf m s;
  u = Bd.slotOf p 1 c;
  case Ru.canAct u and Bd.uKind u != 2 of
    False -> Md.oops m "that unit cannot change mode now"
  | True -> Bd.setSide (Md.cue { m | msg = (case u.mode == 0 of True -> "overwatch" | False -> "back to attack mode") } Sfx.toggle)
                    s (Bd.setSlot p 1 c { u | mode = 1 - u.mode, ready = 0 }).
charge m s c =
  p = Bd.sideOf m s;
  u = Bd.slotOf p 1 c;
  case Ru.canAct u and Bd.uKind u == 2 of
    False -> Md.oops m "only ready artillery charges"
  | True -> Bd.setSide (Md.cue { m | msg = "charging" } Sfx.charge) s (Bd.setSlot p 1 c { u | chg = 1, ready = 0 }).
slide m s fz fc tz tc =
  p = Bd.sideOf m s;
  u = Bd.slotOf p fz fc;
  ok = Ru.canAct u and Bd.uKind u != 1 and not (Bd.occ p tz tc);
  case ok of
    False -> Md.oops m "cannot move that unit"
  | True -> Md.cue { m | anim = Md.An 3 s fz fc tz tc 0 0, msg = (case tz == 2 of True -> "retreat" | False -> "advance") } Sfx.move.
attack m s c tz tc =
  u = Bd.slotOf (Bd.sideOf m s) 1 c;
  ok = Ru.canAct u and u.mode == 0 and Bd.uKind u != 2 and Ru.targetOk m s c tz tc;
  case ok of
    False -> Md.oops m "no valid attack there"
  | True -> Md.cue (Md.note { m | anim = Md.An 1 s 1 c tz tc 0 0,
                                  puffs = smoke m.puffs
                                                (Bd.muzzle m s c (Bd.aimYaw m s c tz tc))
                                                (case Bd.uSoft u == 1 of True -> 3 | False -> 6)
                                                (case Bd.uSoft u == 1 of True -> 0 | False -> 60) }
                                                "{Md.sideName s}: {Cd.cName (Bd.uCard u)} attacks {tgtName tz (tc + 1)}")
                                                (case Bd.uSoft u == 1 of True -> Sfx.rifle | False -> Sfx.cannon).
# muzzle smoke: n puffs around a point, held (negative age) until the shot
smoke ps pos n delay | n == 0 = ps.
smoke ps pos n delay =
  (x, y, z) = pos;
  smoke ((x + (n * 271) % 300 - 150, y + (n * 97) % 200 - 100, z + (n * 181) % 300 - 150, 0 - delay - n * 25) :: ps) pos (n - 1) delay.
tgtName 3 c = "the HQ".
tgtName z c = "{Md.zoneName z} {c}".
fire m s c tz tc =
  u = Bd.slotOf (Bd.sideOf m s) 1 c;
  ok = Ru.canAct u and u.chg == 1 and Bd.uKind u == 2 and Ru.fireOk m s tz tc;
  case ok of
    False -> Md.oops m "artillery must be charged, and aimed at the rear or the HQ"
  | True -> Md.cue (Md.note { m | anim = Md.An 2 s 1 c tz tc 0 0 } "{Md.sideName s}: artillery fires at {tgtName tz (tc + 1)}") Sfx.shot.

advance m dt =
  Md.An kind s fz fc tz tc t done = m.anim;
  t2 = t + dt;
  m1 = case done == 0 and t2 >= Md.durOf kind / 2 of
    True -> { (midpoint m kind s fz fc tz tc) | anim = Md.An kind s fz fc tz tc t2 1, snap = m.snap + m.auto * Pr.bi (kind < 4) }
  | False -> { m | anim = Md.An kind s fz fc tz tc t2 done };
  case t2 >= (case kind == 4 of True -> 0 | False -> Md.durOf kind) of
    True -> finishAn m1 kind s fz fc tz tc
  | False -> m1.
midpoint m 1 s fz fc tz tc = Ru.resolveAttack m s fc tz tc.
midpoint m 2 s fz fc tz tc =
  m2 = Ru.spend m s 1 fc;
  a = Bd.slotOf (Bd.sideOf m s) 1 fc;
  Ru.landBlow m2 s fc tz tc a.atk.
midpoint m k s fz fc tz tc = m.
finishAn m 3 s fz fc tz tc =
  p = Bd.sideOf m s;
  u = Bd.slotOf p fz fc;
  m2 = Bd.setSide m s (Bd.setSlot (Bd.setSlot p fz fc Bd.noU) tz tc { u | ready = 0, chg = 0, born = 600, mode = 0 });
  { m2 | anim = Md.noAn }.
finishAn m k s fz fc tz tc = { m | anim = Md.noAn }.

ageAll m dt =
  m1 = chase m dt;
  { m1 | me = ageSide m.me dt, en = ageSide m.en dt, bt = Int.max 0 (m.bt - dt), fx = ageFx m.fx dt Nil,
         marks = ageMarks m.marks dt Nil, vt = (case m.turn == 1 of True -> Int.min 400 (m.vt + dt) | False -> Int.max 0 (m.vt - dt)),
         gone = ageGone m.gone dt, dealt = Int.min 1000 (m.dealt + dt),
         nums = ageNums m.nums dt Nil, shake = Int.max 0 (m.shake - dt), puffs = agePuffs m.puffs dt Nil }.
agePuffs Nil dt acc = acc.
agePuffs ((x, y, z, t) :: r) dt acc | t + dt > 700 = agePuffs r dt acc.
agePuffs ((x, y, z, t) :: r) dt acc = agePuffs r dt ((x, y, z, t + dt) :: acc).
# the visual state chasing the model: the cursor ring glides a third of
# the way to its slot each tick; hovT counts since the hover last moved
chase m dt =
  (tx, tz) = ringTarget m;
  (x, z) = m.ring;
  ring2 = (x + (tx - x) * 35 / 100, z + (tz - z) * 35 / 100);
  hov2 = (m.zone, m.cur);
  same = hov2 == m.hov;
  (sv, st) = m.supV;
  sv2 = case sv < m.me.stock of True -> sv + 1 | False -> (case sv > m.me.stock of True -> sv - 1 | False -> sv);
  m2 = { m | ring = ring2, hov = hov2, hovT = (case same of True -> Int.min 2000 (m.hovT + dt) | False -> 0),
             supV = (sv2, case sv2 == m.me.stock of True -> Int.min 1000 (st + dt) | False -> 0) };
  case same of True -> { m2 | hs = Pr.clampTo m2.hs (Ui.hsMax m2) } | False -> Ui.followCard m2.
ringTarget m = case m.sel of
    Md.STarget az ac -> (case m.zone == 3 of
        True -> (0, Bd.zOf 1 3 + 700)
      | False -> (Bd.colX m.cur, Bd.zOf 1 m.zone))
  | s -> (case m.zone == 0 of True -> m.ring | False -> (Bd.colX m.cur, Bd.zOf 0 m.zone)).
ageGone (i, t) dt = (i, Int.min 1000 (t + dt)).
ageMarks Nil dt acc = acc.
ageMarks ((x, z, t) :: r) dt acc | t + dt > 20000 = ageMarks r dt acc.
ageMarks ((x, z, t) :: r) dt acc = ageMarks r dt ((x, z, t + dt) :: acc).
ageNums Nil dt acc = acc.
ageNums ((x, z, s, t) :: r) dt acc | t + dt > 750 = ageNums r dt acc.
ageNums ((x, z, s, t) :: r) dt acc = ageNums r dt ((x, z, s, t + dt) :: acc).
ageSide p dt = { p | fwd = ageRow p.fwd dt, rear = ageRow p.rear dt }.
ageRow row dt = row |> List.map (fn u -> ageU u dt).
ageU u dt | u.id < 0 = u.
ageU u dt | u.dead == 1 and u.dt + dt > 420 = Bd.noU.
ageU u dt = { u | flash = Int.max 0 (u.flash - dt), born = Int.min 1000 (u.born + dt), dt = u.dt + dt }.
ageFx Nil dt acc = acc.
ageFx ((x, y, z, t) :: r) dt acc | t + dt > 380 = ageFx r dt acc.
ageFx ((x, y, z, t) :: r) dt acc = ageFx r dt ((x, y, z, t + dt) :: acc).

# the track beside the .qa (`#: music` above: run points FPR_ASSETS at it,
# pack copies it into the bundle); M toggles it
