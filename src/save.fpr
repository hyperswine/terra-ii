# ---- the profile and the live game on the disk -----------------------------------------
# An append-only record per game (std/fs over the QLOG log), folded into the model.

unsafe module.

Pr = use "prelude".
Bd = use "board".
Md = use "model".
Game = use "std/game".
Core = use "mods/coreutil".

# ---- the profile ------------------------------------------------------------------
# One append-only record on the disk (std/fs over the QLOG log at
# terra2/profile), a line per event: "start <seed>" when a game begins,
# "end <seed> win|loss <rounds> <hqMe> <hqEn> <called> <lost> <destroyed>
# <damage>" when an HQ falls.  Replayed at boot and folded into the
# totals; every line the game writes is folded into the model's copy
# too, so the Stats screen never lags the disk.  A start with no end is
# a game abandoned (a restart, a quit).

profUrl = "terra2/profile".

profFold p line =
  n = strlen line;
  (w, i) = Core.wordAt line 0 n;
  case Core.strEq w "start" of
    True -> { p | played = p.played + 1, gone = p.gone + 1 }
  | False -> (case Core.strEq w "end" of
      True -> profEnd p line i n
    | False -> p).
profEnd p line i n =
  (sd, i2) = Core.wordAt line i n;
  (res, i3) = Core.wordAt line i2 n;
  ws = intsFrom line i3 n;
  won = Core.strEq res "win";
  rounds = Pr.nth ws 0 0;
  best2 = case won and (p.best == 0 or rounds < p.best) of True -> rounds | False -> p.best;
  { p | gone = Int.max 0 (p.gone - 1), won = p.won + Pr.bi won, lost = p.lost + Pr.bi (not won),
        rounds = p.rounds + rounds, best = best2,
        calls = p.calls + Pr.nth ws 3 0, losses = p.losses + Pr.nth ws 4 0,
        recent = (Pr.bi won, rounds, Pr.nth ws 1 0, Pr.nth ws 2 0, Pr.nth ws 3 0, Pr.nth ws 4 0, Pr.nth ws 5 0, Pr.nth ws 6 0) :: p.recent }.
intsFrom line i n | i >= n = Nil.
intsFrom line i n =
  (w, j) = Core.wordAt line i n;
  case strlen w == 0 of
    True -> intsFrom line j n
  | False -> Core.parseDigits w :: intsFrom line j n.

# a line for the disk: folded now, written by update's flush
rec m line = { m | prof = profFold m.prof line, recs = (profUrl, line) :: m.recs }.
startRec m = rec m "start {m.seed}".
endRec m won =
  w = case won of True -> "win" | False -> "loss";
  m2 = rec m "end {m.seed} {w} {m.tno} {Int.max 0 m.me.hq} {Int.max 0 m.en.hq} {m.called} {m.lostU} {m.kills} {m.dmg}";
  { m2 | recs = (gameUrl, "none") :: m2.recs, dirty = 0 }.

# ---- the live game --------------------------------------------------------------
# The board, saved at terra2/game whenever a turn of yours begins (the
# state after income, with nothing in flight) and cleared to "none" when
# an HQ falls.  Boot reads it back; the title then offers Continue.  Only
# what the rules need is kept -- sides, turn, ENV, the counters -- never
# the animation, the cursor or the queue.  Units go out as eleven
# numbers each with the id shifted by one so an empty slot is 0.

gameUrl = "terra2/game".
gameRec m =
  "terra2 1\ng {m.seed} {m.turn} {m.tno} {m.env} {m.called} {m.lostU} {m.kills} {m.dmg}\n" + sideRec m.me + sideRec m.en.
sideRec p =
  "s {p.hq} {p.stock}\nd {ints p.deck}\nh {ints p.hand}\nf {units p.fwd}\nr {units p.rear}\n".
ints Nil = "".
ints (x :: r) = "{x} " + ints r.
units Nil = "".
units (u :: r) =
  "{u.id + 1} {u.hp} {u.atk} {u.mode} {u.ready} {u.down} {u.rdy} {u.chg} {u.vet} {u.age} {u.ow} " + units r.

loadGame m s =
  ls = Core.lines s;
  case List.len ls == 12 of
    False -> m
  | True -> loadGame2 m ls.
loadGame2 m ls =
  g = lineInts (Pr.nth ls 1 "");
  p0 = sideOfLines (Pr.nth ls 2 "") (Pr.nth ls 3 "") (Pr.nth ls 4 "") (Pr.nth ls 5 "") (Pr.nth ls 6 "");
  p1 = sideOfLines (Pr.nth ls 7 "") (Pr.nth ls 8 "") (Pr.nth ls 9 "") (Pr.nth ls 10 "") (Pr.nth ls 11 "");
  { m | me = p0, en = p1, seed = Pr.nth g 0 m.seed, turn = Pr.nth g 1 0, tno = Pr.nth g 2 0, env = Pr.nth g 3 0,
        called = Pr.nth g 4 0, lostU = Pr.nth g 5 0, kills = Pr.nth g 6 0, dmg = Pr.nth g 7 0, cont = 1 }.
# a line's numbers after its one-letter tag
lineInts line =
  n = strlen line;
  (w, i) = Core.wordAt line 0 n;
  intsFrom line i n.
sideOfLines sl dl hl fl rl =
  sv = lineInts sl;
  { hq = Pr.nth sv 0 15, stock = Pr.nth sv 1 0, deck = lineInts dl, hand = lineInts hl,
    fwd = unitsOf (lineInts fl) 5, rear = unitsOf (lineInts rl) 5 }.
unitsOf ns 0 = Nil.
unitsOf ns k = unitOf ns :: unitsOf (List.drop ns 11) (k - 1).
unitOf ns =
  { Bd.noU | id = Pr.nth ns 0 0 - 1, hp = Pr.nth ns 1 0, atk = Pr.nth ns 2 0, mode = Pr.nth ns 3 0, ready = Pr.nth ns 4 0,
          down = Pr.nth ns 5 0, rdy = Pr.nth ns 6 0, chg = Pr.nth ns 7 0, vet = Pr.nth ns 8 0, age = Pr.nth ns 9 0,
          ow = Pr.nth ns 10 0, born = 1000 }.

# the snapshot joins the records; it is announced when the disk confirms it
saveGame m = { m | recs = (gameUrl, gameRec m) :: m.recs, dirty = 0 }.
# idle with a turn of yours to keep: the save goes out with the records
idleNow m =
  Md.An kind s fz fc tz tc t done = m.anim;
  kind == 0 and (case m.queue of Nil -> True | q -> False) and m.over == 0 and m.turn == 0.

# ---- the disk: asked for as tasks, answered as messages -------------------------
# Nothing here touches the disk. init asks for the profile and the saved game
# (std/game tasks); each answer is a message, and these functions are what
# update does with it. A game with no disk gets Err "no storage" for both.
loadTasks toProfile toGame =
  Game.batch [Game.attempt (Game.replay profUrl) toProfile, Game.attempt (Game.readLatest gameUrl) toGame].

# no disk; or a profile, which may be empty (absent or unreadable: a fresh one)
gotProfile m (Ok s) = profLine { m | prof = profOf (Ok s), fsOn = 1 }.
gotProfile m (Err why) | Core.strEq why Game.noStorage =
  ({ m | fsOn = 0 }, [Game.log "[terra2] profile: no disk, games are not recorded"]).
gotProfile m (Err why) = profLine { m | prof = Md.profEmpty, fsOn = 1 }.
profLine m =
  p = m.prof;
  (m, [Game.log "[terra2] profile: {p.played} games ({p.won} won, {p.lost} lost, {p.gone} abandoned)"]).

# the saved game is offered only on the title: one that arrives after a game
# was started does not replace it
gotGame m r | m.fsOn == 0 = (m, Nil).
gotGame m r | m.title != 1 = (m, Nil).
gotGame m r =
  m2 = gameOf m r;
  (m2, case m2.cont == 1 of True -> [Game.log "[terra2] a game is waiting: turn {m2.tno}"] | False -> Nil).
gameOf m (Ok s) = loadGame m s.
gameOf m (Err e) = m.
profOf (Ok s) = Core.lines s |> List.fold (fn line p -> profFold p line) Md.profEmpty.
profOf (Err e) = Md.profEmpty.

# ---- saves: one at a time, each acknowledged ------------------------------------
# `recs` is what the turn produced (newest first). flush moves it to `out`, the
# records the disk has not confirmed, in order, each with an identity; one is
# in flight at a time (`busy`), and only its acknowledgement removes it, so a
# record made while a write is running waits its turn and nothing is dropped.
#
#   Wrote id (Ok _)    confirmed: the record leaves `out`; a snapshot is
#                      announced now ("game saved"), not when it was asked for
#   Wrote id (Err _)   a snapshot replaces what is there, so it is simply kept
#                      and sent again later. A profile EVENT must not be sent
#                      twice (it would count a game twice), and a failed reply
#                      does not say whether it was stored: the record is marked
#                      unsure and the profile is read back first
#   Checked id (Ok s)  the profile's last line is the record: confirmed after
#                      all; otherwise it is not there and may be sent again
#   an answer for another id is stale (a restart, a retry): ignored
# After a failure the queue rests for `retryTicks` before it is tried again.
Out = Type (Out id url text note unsure).
retryTicks = 250.

flush toWrote toChecked m =
  m1 = case m.dirty == 1 and idleNow m of
    True -> saveGame m
  | False -> m;
  m2 = case m1.recs of
    Nil -> m1
  | rs -> (case m1.fsOn == 0 of
      True -> { m1 | recs = Nil }
    | False -> queue { m1 | recs = Nil } (Pr.rev rs Nil));
  pump toWrote toChecked m2.
queue m Nil = m.
queue m ((url, text) :: rest) =
  note = case Core.strEq url gameUrl and not (Core.strEq text "none") of True -> "game saved: turn {m.tno}" | False -> "";
  queue { m | seq = m.seq + 1, out = m.out + [Out (m.seq + 1) url text note 0] } rest.

# send the head, unless one is in flight or the queue is resting
pump toWrote toChecked m | m.busy == 1 or m.wait > 0 = (m, Nil).
pump toWrote toChecked m = case m.out of
    Nil -> (m, Nil)
  | Out id url text note unsure :: rest ->
      (case unsure == 1 of
        True -> ({ m | busy = 1 }, [Game.attempt (Game.replay profUrl) (toChecked id)])
      | False -> ({ m | busy = 1 }, [Game.attempt (Game.append url (text + "\n")) (toWrote id)])).

wrote toWrote toChecked m id r = case m.out of
    Out hid url text note unsure :: rest -> (case hid == id of
        False -> (m, Nil)
      | True -> written toWrote toChecked m rest url text note r)
  | Nil -> (m, Nil).
written toWrote toChecked m rest url text note (Ok r) =
  (m2, cs) = pump toWrote toChecked { m | out = rest, busy = 0 };
  (m2, said note + cs).
written toWrote toChecked m rest url text note (Err why) | Core.strEq url gameUrl or Core.strEq why Game.noStorage =
  ({ m | busy = 0, wait = retryTicks }, [Game.log "[terra2] save failed, kept: {why}"]).
written toWrote toChecked m rest url text note (Err why) =
  (m2, cs) = pump toWrote toChecked { m | out = unsureHead m.out, busy = 0 };
  (m2, Game.log "[terra2] save unconfirmed, reading the profile back: {why}" :: cs).
said "" = Nil.
said note = [Game.log "[terra2] {note}"].
unsureHead (Out id url text note unsure :: rest) = Out id url text note 1 :: rest.
unsureHead Nil = Nil.

checked toWrote toChecked m id r = case m.out of
    Out hid url text note unsure :: rest -> (case hid == id and unsure == 1 of
        False -> (m, Nil)
      | True -> reconciled toWrote toChecked m rest url text note r)
  | Nil -> (m, Nil).
reconciled toWrote toChecked m rest url text note (Ok s) | Core.strEq (lastLine (Core.lines s) "") text =
  (m2, cs) = pump toWrote toChecked { m | out = rest, busy = 0 };
  (m2, Game.log "[terra2] save confirmed on reading back" :: cs).
# not there: it may be sent again, after a rest
reconciled toWrote toChecked m rest url text note (Ok s) =
  ({ m | out = Out (m.seq + 1) url text note 0 :: rest, seq = m.seq + 1, busy = 0, wait = retryTicks },
   [Game.log "[terra2] save was not stored, kept"]).
reconciled toWrote toChecked m rest url text note (Err why) =
  ({ m | busy = 0, wait = retryTicks }, [Game.log "[terra2] save still unconfirmed: {why}"]).
lastLine Nil last = last.
lastLine (l :: r) last = case strlen l == 0 of True -> lastLine r last | False -> lastLine r l.
# the tick counts the rest down
rested m | m.wait > 0 = { m | wait = m.wait - 1 }.
rested m = m.
