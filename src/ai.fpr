# ---- the AI (side 1): greedy, positional ------------------------------------------------

Pr = use "prelude".
L = use "std/list".
Cd = use "cards".
Bd = use "board".
Md = use "model".
Ru = use "rules".

# calls: up to three, dearest affordable first, supports to a covered rear
# slot, combat to a forward slot in front of its own rear; acts: every ready
# forward unit hits the HQ through a lane if it can, else an uncovered rear
# unit, else the weakest forward unit in reach, else goes to overwatch;
# artillery charges then fires at the richest rear unit (or the HQ).

# unsafe: aiCalls and aiCall recurse into each other (n falls by one a
# round trip), which a measure cannot state
aiPlan : unsafe _ -> _ .
aiPlan m =
  p = m.en;
  (calls, p2) = aiCalls m p 0 Nil 3;
  acts = aiActs m p2 0 Nil;
  beats (calls + acts).
beats : (l : List _ | measure l) -> _ .
beats l = case l of
    Nil -> Nil
  | a :: r -> a :: Md.ABeat :: beats r.
aiCalls : unsafe _ -> _ -> _ -> _ -> Int -> _ .
aiCalls m p i acc n | n == 0 = (L.reverse acc, p).
aiCalls m p i acc n =
  k = bestCard p.hand p.stock 0 (0 - 1) (0 - 1);
  if k < 0
    then (L.reverse acc, p)
    else aiCall m p acc n k (Cd.cardOf (L.getWithDefault 0 k p.hand)).
aiCall : unsafe _ -> _ -> _ -> Int -> Int -> _ -> _ .
aiCall m p acc n k cd =
  z = if Cd.cKind cd == 1 then 2 else 1;
  c = freeCol p z;
  if c < 0
    then (L.reverse acc, p)
    else aiCalls m (Bd.setSlot { p | stock = p.stock - Cd.cCost cd, hand = Pr.delAt p.hand k } z c (Bd.mkU cd 0))
                     0 (Md.ACall 1 k z c :: acc) (n - 1).
# index of the dearest affordable card (support preferred when nothing is in the rear)
bestCard : (l : List _ | measure l) -> Int -> Int -> Int -> Int -> Int .
bestCard l stock i best bcost = case l of
    Nil -> best
  | k :: r ->
      co = Cd.cCost (Cd.cardOf k);
      worth = co + 2 * Cd.cGen (Cd.cardOf k);
      if co <= stock and worth > bcost
        then bestCard r stock (i + 1) i worth
        else bestCard r stock (i + 1) best bcost.
# a free column for zone z: forward slots in front of a rear unit first,
# rear slots behind a forward unit first, centre outward
freeCol p z = fcGo p z [2, 1, 3, 0, 4] (0 - 1).
fcGo : _ -> Int -> (l : List Int | measure l) -> Int -> Int .
fcGo p z l best = case l of
    Nil -> best
  | c :: r ->
      if Bd.occ p z c then fcGo p z r best
      else if Bd.occ p (3 - z) c then c
      else if best < 0 then fcGo p z r c
      else fcGo p z r best.

aiActs : _ -> _ -> (c : Int | measure (4 - c)) -> _ -> _ .
aiActs m p c acc | c > 4 = L.reverse acc.
aiActs m p c acc =
  u = Bd.slotOf p 1 c;
  ru = Bd.slotOf p 2 c;
  acc2 = if Ru.canAct ru and Bd.uKind ru != 1 and not (Bd.occ p 1 c)
    then Md.AAdvance 1 c :: acc
    else acc;
  if Ru.canAct u and u.mode == 0
    then aiActs m p (c + 1) (aiUnit m p c u :: acc2)
    else aiActs m p (c + 1) acc2.
aiUnit m p c u | Bd.uKind u == 2 = aiArt m c u.
aiUnit m p c u =
  o = m.me;
  if Ru.targetOk m 1 c 3 c
    then Md.AAttack 1 1 c 3 c
    else aiPick m c (bestIn m c 2) (bestIn m c 1).
aiPick m c rc fc | rc >= 0 = Md.AAttack 1 1 c 2 rc.
aiPick m c rc fc | fc >= 0 = Md.AAttack 1 1 c 1 fc.
aiPick m c rc fc = Md.AOver 1 c.
# the weakest valid target in zone tz within reach of column c, or -1
bestIn m c tz = biGo m c tz (Int.max 0 (c - 1)) (Int.min 4 (c + 1)) (0 - 1) 999.
biGo : _ -> Int -> Int -> (k : Int | measure (hi - k)) -> (hi : Int) -> Int -> Int -> Int .
biGo m c tz k hi best bhp | k > hi = best.
biGo m c tz k hi best bhp =
  u = Bd.slotOf m.me tz k;
  if Ru.targetOk m 1 c tz k and u.hp < bhp
    then biGo m c tz (k + 1) hi k u.hp
    else biGo m c tz (k + 1) hi best bhp.
aiArt m c u | u.chg == 0 = Md.ACharge 1 c.
aiArt m c u =
  rc = richest m.me.rear 0 (0 - 1) (0 - 1);
  if rc < 0
    then Md.AFire 1 c 3 0
    else Md.AFire 1 c 2 rc.
richest : (l : List _ | measure l) -> Int -> Int -> Int -> Int .
richest l i best bg = case l of
    Nil -> best
  | u :: r ->
      if Bd.alive u and Cd.cGen (Bd.uCard u) > bg then richest r (i + 1) i (Cd.cGen (Bd.uCard u))
      else richest r (i + 1) best bg.

# ---- tactical hint for the player's selected unit (replaceable chunked search) --------
Game = use "std/game".

hintJob m z c = Game.job (fn u -> (hintCands m z c, 0 - 1, "")) hintStep.

hintStep st =
  (cands, best, lbl) = st;
  hintChunk 2 cands best lbl.

hintChunk : Int -> (cands : List _ | measure cands) -> Int -> String -> _ .
hintChunk n cands best lbl = case cands of
    Nil -> Game.done (if lbl == "" then "" else "hint: {lbl}")
  | (s, l) :: more ->
      if n == 0 then Game.more (cands, best, lbl)
      else if s > best then hintChunk (n - 1) more s l
      else hintChunk (n - 1) more best lbl.

hintCands m z c =
  u = Bd.slotOf m.me z c;
  if Ru.canAct u
    then (if z == 2
      then (if Bd.uKind u != 1 and not (Bd.occ m.me 1 c)
          then [(45, "advance to front (V)")]
          else Nil)
      else (if Bd.uKind u == 2
        then hintArt m c u
        else hintFwd m c u))
    else Nil.

hintArt m c u | u.chg == 0 = [(50, "charge artillery (C)")].
hintArt m c u =
  hqScore = 40 + u.atk * 3 + (if m.en.hq <= u.atk then 500 else 0);
  retreat = if not (Bd.occ m.me 2 c) then [(10, "retreat to rear (R)")] else Nil;
  hintFireCands m u 0 ((hqScore, "fire at enemy HQ (F)") :: retreat).

hintFireCands : _ -> _ -> (tc : Int | measure (4 - tc)) -> _ -> _ .
hintFireCands m u tc acc | tc > 4 = acc.
hintFireCands m u tc acc =
  acc2 = if Ru.fireOk m 0 2 tc
    then
      eu = Bd.slotOf m.en 2 tc;
      sc = 60 + Cd.cGen (Bd.uCard eu) * 25 + (if eu.hp <= u.atk then 40 else 0);
      (sc, "fire at rear {tc + 1} ({Cd.cName (Bd.uCard eu)}) (F)") :: acc
    else acc;
  hintFireCands m u (tc + 1) acc2.

hintFwd m c u =
  base = (if u.mode == 0 then [(25, "overwatch (O)")] else Nil) +
         (if not (Bd.occ m.me 2 c) then [(10, "retreat to rear (R)")] else Nil);
  if u.mode == 0
    then hintAtkCands m c u (Int.max 0 (c - 1)) (Int.min 4 (c + 1)) base
    else base.

hintAtkCands : _ -> Int -> _ -> (tc : Int | measure (hi - tc)) -> (hi : Int) -> _ -> _ .
hintAtkCands m c u tc hi acc | tc > hi = acc.
hintAtkCands m c u tc hi acc =
  a1 = if Ru.targetOk m 0 c 3 tc
    then (100 + u.atk * 4 + (if m.en.hq <= u.atk then 500 else 0), "attack enemy HQ (A)") :: acc
    else acc;
  a2 = if Ru.targetOk m 0 c 2 tc
    then
      eu2 = Bd.slotOf m.en 2 tc;
      sc2 = 70 + Cd.cGen (Bd.uCard eu2) * 20 + (if eu2.hp <= u.atk then 45 else 0);
      (sc2, "attack rear {tc + 1} ({Cd.cName (Bd.uCard eu2)}) (A)") :: a1
    else a1;
  a3 = if Ru.targetOk m 0 c 1 tc
    then
      eu1 = Bd.slotOf m.en 1 tc;
      sc1 = 40 + eu1.atk * 5 + (if eu1.hp <= u.atk then 45 else 0);
      (sc1, "attack fwd {tc + 1} ({Cd.cName (Bd.uCard eu1)}) (A)") :: a2
    else a2;
  hintAtkCands m c u (tc + 1) hi a3.
